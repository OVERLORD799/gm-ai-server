# Host loopback ports consumed by the default GMrobot client configuration.
VLM_HOST_PORT=18080
PERCEPTION_HOST_PORT=18082

# Persistent model/cache root. It is intentionally ignored by Git.
GM_AI_DATA_DIR=./data

# Override with a trusted mirror only when direct Hugging Face access is unavailable.
HF_ENDPOINT=https://huggingface.co
HF_HUB_DISABLE_XET=1
HF_HUB_DOWNLOAD_TIMEOUT=120
HF_HUB_MAX_WORKERS=2
MODEL_DOWNLOAD_ATTEMPTS=30
MODEL_DOWNLOAD_RETRY_DELAY_S=5
MODEL_DOWNLOAD_CONNECTIONS=8
# Set to hub only when diagnosing aria2; aria2 is resumable and is the recovery default.
MODEL_DOWNLOAD_TRANSPORT=aria2
# Used only when HF_HUB_DISABLE_XET is deliberately changed to 0.
HF_XET_HIGH_PERFORMANCE=0
HF_XET_CLIENT_ENABLE_ADAPTIVE_CONCURRENCY=0
HF_XET_FIXED_DOWNLOAD_CONCURRENCY=8

# Set to 1 only after all model snapshots have been prefetched.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
